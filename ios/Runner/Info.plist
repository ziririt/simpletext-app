<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
		<!-- 2026-08-16 앱 잠금. 이 문구가 없으면 Face ID를 부르는 순간
	     iOS가 앱을 그냥 죽인다(권한 설명 누락). -->
	<key>NSFaceIDUsageDescription</key>
	<string>Skyblue Note uses Face ID to unlock your notes.</string>
	<!-- 2026-08-16 소유자 신고 — "설정의 목록에서 Skyblue Note가 없다."
	     맞는 말이었고, 원인이 여기 있었다.

	     컨테이너를 '쓰는' 것과 사용자에게 '보이는' 것은 다른 문제다.
	     자격(Runner.entitlements)만 있으면 앱은 컨테이너를 읽고 쓸 수
	     있지만, 설정 앱의 저장된 앱 목록과 파일 앱에 이름이 뜨려면
	     여기에 '이 컨테이너를 사람에게 보여 달라'고 따로 적어야 한다.
	     그걸 안 적어 놔서, 우리가 화면에 안내한 절차를 그대로 따라가면
	     없는 항목을 찾게 되어 있었다.

	     IsDocumentScopePublic: 파일 앱에 폴더로 보인다
	     ContainerName        : 그 폴더에 붙는 이름
	     SupportedFolderLevels: Any — 우리는 notes/ tombs/ 로 나눠 쓴다

	     주의: iOS는 이 값을 앱을 처음 깔 때 한 번 읽고 캐시한다. 값을
	     바꾼 뒤에는 빌드 번호가 올라가야 다시 읽는다. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.ziririt.simpletext</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Skyblue Note</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>CFBundleDisplayName</key>
	<string>Skyblue Note</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
		<string>en</string>
		<string>ja</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>es</string>
		<string>pt</string>
		<string>de</string>
		<string>fr</string>
	</array>
	<!-- 2026-08-17 다른 앱에서 텍스트 파일을 'Skyblue Note로 열기'.

	     아이폰 공유 시트에 이름을 올리려면 별도 익스텐션 타깃이 필요하고,
	     그건 Xcode 프로젝트 파일을 건드리는 일이라 여기서 하지 않았다.
	     그 파일이 망가지면 빌드 전체가 죽는다(2026-08-15에 겪었다).
	     문서 열기는 plist만으로 되고 위험이 없다. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Text</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<!-- 2026-08-18 — Alternate 에서 Default 로 올렸다.
			     Alternate 는 "다룰 줄은 압니다" 쪽이고, Default 는 "이
			     종류를 다루는 것이 제 일입니다" 쪽이다. 이 앱은 글을
			     읽고 고치는 앱이니 뒤가 맞다. Owner 는 그 형식을 우리가
			     정의했을 때만 쓰는 것이라 여기에는 안 맞는다.
			     파일 앱의 '항상 이 앱으로 열기' 목록에서 위로 온다. -->
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.plain-text</string>
				<string>public.utf8-plain-text</string>
				<string>net.daringfireball.markdown</string>
				<string>public.comma-separated-values-text</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>CFBundleName</key>
	<string>simpletext</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-2336764115275414~3251918630</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSUserTrackingUsageDescription</key>
	<string>This identifier will be used to deliver ads that are more relevant to you.</string>
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 홈 화면 위젯에서 앱으로 들어오는 문(2026-08-19).
	     위젯의 줄을 누르면 skybluenote://note?id=… 로 이 앱을 부른다.
	     여기 등록해 두지 않으면 iOS가 그 주소를 아무도 안 받는 것으로 보고
	     조용히 버린다 — 위젯은 눌리는데 아무 일도 안 일어난다. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.ziririt.simpletext</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>skybluenote</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
