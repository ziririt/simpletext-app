// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
//
// 2026-08-17 — 'simpletext'에서 바꿨다. 이 값이 번들 파일 이름을 정한다
// (simpletext.app -> Skyblue Note.app). 맥OS의 파인더와 독은 plist의
// CFBundleDisplayName이 아니라 **디스크의 파일 이름**을 보여 준다.
// 이름표만 바꿔 단 가짜 앱을 막기 위한 안전장치다. 그래서 plist에
// 'Skyblue Note'가 이미 들어 있었는데도 독에는 simpletext로 떴다.
// 아이폰은 홈 화면이 CFBundleDisplayName을 그대로 쓰기 때문에 멀쩡했다.
PRODUCT_NAME = Skyblue Note

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.ziririt.simpletext

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.ziririt. All rights reserved.

// 2026-08-17 — 맥 앱에 아이클라우드를 붙이기 위한 서명 설정.
//
// 지금까지 맥 빌드는 임시 서명(프로젝트 설정의 CODE_SIGN_IDENTITY = "-")
// 이었다. 임시 서명에는 자격(entitlement)을 붙일 수 없어서 아이클라우드가
// 원리적으로 불가능했다 — codesign으로 확인했다.
//
// 프로젝트 파일(project.pbxproj)은 건드리지 않는다. 망가지면 빌드 전체가
// 죽는 자리다(2026-08-15에 겪었다). 여기 넣는 이유: Xcode의 설정 우선순위
// 에서 '타깃의 xcconfig'가 '프로젝트 설정'보다 위라서, 프로젝트의 "-"를
// 이 파일이 덮는다.
DEVELOPMENT_TEAM = ZK846VZN92
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
